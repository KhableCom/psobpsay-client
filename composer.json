{
    "name": "psobpsay/client",
    "description": "Server-to-server client for the psobpsay ad network: one batched serve call per page, fail-empty, with a Blade card and a React stub.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "psobpsay",
        "ads"
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8||^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PsobPsay\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PsobPsay\\Client\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PsobPsay\\Client\\PsobPsayClientServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
